# Groq API configuration (OpenAI-compatible endpoint) — copy this file to
# backend/.env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Timeouts / retries
GROK_TIMEOUT_SECONDS=20
GROK_MAX_RETRIES=2

# Input/output limits
MAX_INPUT_CHARS=2000
MAX_OUTPUT_TOKENS=600

# CORS
FRONTEND_ORIGIN=http://localhost:3000